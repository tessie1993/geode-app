# Build output
.gradle/
build/
.cxx/
.kotlin/
local.properties

# Upload-key material — never commit.
keystore.properties
*.jks
*.keystore

# Service credentials. The upload feature needs OAuth client ids and secrets
# for YouTube, TikTok and Instagram, and the moment those exist locally they
# must not be committable — a leaked client secret is a rotation and a store
# re-verification, not an inconvenience.
.env
.env.*
!.env.example
secrets.properties
google-services.json

# Agent tooling is local-only and is not tracked in this repository. AGENTS.md is
# the exception: it is the architecture map, kept current by .github/workflows/arch-map.yml.
.claude/
.agents/
.codex/
__pycache__/
*.logcat
