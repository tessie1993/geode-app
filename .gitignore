# Build output
.gradle/
build/
.cxx/
.kotlin/
local.properties

# Upload-key material — never commit.
keystore.properties
*.jks
*.keystore

# Service credentials. The upload feature needs OAuth client ids and secrets
# for YouTube, TikTok and Instagram, and the moment those exist locally they
# must not be committable — a leaked client secret is a rotation and a store
# re-verification, not an inconvenience.
.env
.env.*
!.env.example
secrets.properties
google-services.json

# Agent tooling is local-only and is not tracked in this repository. The exceptions:
# AGENTS.md, the architecture map kept current by .github/workflows/arch-map.yml;
# .claude/settings.json, the plugins and skill listing every Claude session here gets;
# and .claude/skills/, the repo's own skills. Personal overrides stay in
# .claude/settings.local.json.
.claude/*
!.claude/settings.json
!.claude/skills/
.agents/
.codex/
__pycache__/
*.logcat

# Local audit scratch (play-policy-insights skill).
.scratch/

# Android Studio: per-user and per-machine state. The shared project settings in .idea/
# (.name, vcs.xml, compiler.xml, gradle.xml, kotlinc.xml, AndroidProjectSystem.xml,
# runConfigurations.xml, codeStyles/) stay tracked.
.idea/workspace.xml
.idea/modules/
.idea/caches/
.idea/deviceStreaming.xml
.idea/deviceManager.xml
.idea/deploymentTargetSelector.xml
.idea/appInsightsSettings.xml
.idea/migrations.xml
.idea/misc.xml
.idea/shelf/
*.iml
