<?xml version="1.0" encoding="utf-8"?>
<!--
  A glass droplet, in the liquid-glass palette (docs/design/liquid-glass/README.md): a frosted
  translucent body, a faint mint-to-lavender iridescent wash, a lighter rim and a top-left
  specular highlight — the same look every `GlassSurface` draws, applied to the app's own mark.

  Sits inside the 72x72 centre of the 108x108 viewport so it survives an adaptive-icon mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Frosted glass droplet body. -->
    <path
        android:pathData="M54,26 C67,43 76,54 76,66 A22,22 0 1,1 32,66 C32,54 41,43 54,26 Z"
        android:fillColor="#8CFFFFFF" />

    <!-- Faint iridescent wash, mint through lavender, echoing every other glass surface. -->
    <path
        android:pathData="M54,26 C67,43 76,54 76,66 A22,22 0 1,1 32,66 C32,54 41,43 54,26 Z"
        android:fillColor="#33BFEBD8" />
    <path
        android:pathData="M54,40 C62,50 68,57 68,66 A14,14 0 1,1 40,66 C40,57 46,50 54,40 Z"
        android:fillColor="#40CDBDF0" />

    <!-- Rim. -->
    <path
        android:pathData="M54,26 C67,43 76,54 76,66 A22,22 0 1,1 32,66 C32,54 41,43 54,26 Z"
        android:strokeColor="#8CFFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:strokeLineJoin="round" />

    <!-- Specular highlight, upper-left. -->
    <path
        android:pathData="M42,48 C44,44 48,40 52,38"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />
</vector>
