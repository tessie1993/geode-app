<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon silhouette. A dedicated drawable rather than reusing the foreground: the system
  tints every non-transparent pixel one colour, so the foreground's translucent fills would
  flatten unevenly. Here the droplet is drawn as a single outline, which survives that.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFF">
    <path
        android:pathData="M54,26 C67,43 76,54 76,66 A22,22 0 1,1 32,66 C32,54 41,43 54,26 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:strokeLineJoin="round" />
</vector>
