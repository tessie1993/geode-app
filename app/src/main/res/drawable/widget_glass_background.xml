<?xml version="1.0" encoding="utf-8"?>
<!-- Black glass on the home screen: near-black at 90%. Denser than the app's matte glass (62%
     over the visual), since a widget sits over any wallpaper and its text must stay readable.
     No hairline edge: 1A retired the crystal edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E60E0E10" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
