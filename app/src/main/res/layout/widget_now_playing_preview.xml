<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview (API 31+): a static copy of the 4x1 layout in NowPlayingWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#14FFFFFF"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_widget_art" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="#ECECF0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_artist"
            android:textColor="#A6A8B2"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_previous"
        android:padding="12dp"
        android:src="@drawable/ic_widget_prev" />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_play_container"
        android:contentDescription="@string/widget_play"
        android:padding="12dp"
        android:src="@drawable/ic_widget_play"
        android:tint="#0E0E10" />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_next"
        android:padding="12dp"
        android:src="@drawable/ic_widget_next" />
</LinearLayout>
