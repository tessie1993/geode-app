<!-- The tour (ui/tour): pointers on the real controls, one-time gesture tips, Settings › Tutorials. -->
<resources>
    <string name="tour_step_of">%1$d of %2$d</string>
    <string name="tour_pane_title">%1$s, step %2$d of %3$d</string>
    <string name="tour_next">Next</string>
    <string name="tour_done">Done</string>
    <string name="tour_skip">Skip</string>
    <string name="tour_skip_tour">Skip tour</string>
    <string name="tour_ok">OK</string>
    <string name="tour_replay_note">You can replay the tour in Settings, under Tutorials &amp; help.</string>

    <!-- First steps: once, on a new install. -->
    <string name="tour_nav_library_title">Start with a song</string>
    <string name="tour_nav_library_body">Open Library and play any song.</string>
    <string name="tour_nav_library_action">Open Library</string>
    <string name="tour_play_song">Play any song to go on.</string>
    <string name="tour_nav_visuals_title">Now see it</string>
    <string name="tour_nav_visuals_body">Visuals turns your music into light.</string>
    <string name="tour_nav_visuals_action">Open Visuals</string>

    <!-- Visuals. -->
    <string name="tour_visuals_tabs_title">Pick a look</string>
    <string name="tour_visuals_tabs_body">Styles picks a look. Customize changes it. Presets saves it. MilkDrop has the classic presets.</string>
    <string name="tour_stage_arrows_title">Next style</string>
    <string name="tour_stage_arrows_body">The arrows step to the next or previous style.</string>
    <string name="tour_stage_tools_title">Up here</string>
    <string name="tour_stage_tools_body">Cast to a TV. The gear has Auto, which changes the style with the music. Studio makes a video. The last one shows the visual alone.</string>
    <string name="tour_stage_record_title">Record</string>
    <string name="tour_stage_record_body">Records the visual and the music as a video. Find it in Studio, under My videos.</string>

    <!-- Customize. -->
    <string name="tour_customize_knobs_title">Quick knobs</string>
    <string name="tour_customize_knobs_body">A few knobs that move the whole look at once.</string>
    <string name="tour_customize_list_title">A group for each part</string>
    <string name="tour_customize_list_body">Look, Shape, Motion, Music and more. Each opens on the basics, with more below.</string>
    <string name="tour_customize_randomize_title">Roll the dice</string>
    <string name="tour_customize_randomize_body">In a group, the dice rolls new settings for it. Undo, next to it, takes them back.</string>

    <!-- Studio. -->
    <string name="tour_studio_render_title">Make a video</string>
    <string name="tour_studio_render_body">Pick a song and a look, then tap Render. It keeps going if you leave the app.</string>
    <string name="tour_studio_videos_title">Your videos</string>
    <string name="tour_studio_videos_body">Your renders and takes are kept under My videos.</string>

    <!-- One-time gesture tips. -->
    <string name="tour_tip_swipe_styles">Tip: swipe sideways on the visual to change style.</string>
    <string name="tour_tip_double_tap_sheet">Tip: double tap the visual to hide or show the options.</string>
    <string name="tour_tip_hold_to_record">Tip: hold the visual to start recording.</string>
    <string name="tour_tip_swipe_up_player">Tip: swipe the mini player up to open Player.</string>
    <string name="tour_tip_swipe_down_knobs">Tip: swipe down on the visual for the quick knobs.</string>
    <string name="tour_tip_swirl_randomize">Tip: draw two circles on the visual for a whole new look.</string>
    <string name="tour_tip_got_it">Got it</string>

