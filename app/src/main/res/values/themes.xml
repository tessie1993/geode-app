<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash shown while the process cold-starts. Background is the liquid-glass base
         colour (GlassPalette.base, docs/design/liquid-glass/README.md) so the handoff to the
         Compose BootIntro overlay — the glass drop falling onto the same water surface — is
         seamless. -->
    <style name="Theme.Geode.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#8C95BB</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.NoActionBar</item>
    </style>
</resources>
