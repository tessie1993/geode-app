<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (auto backup). Presets, playlists, the track library
     and preferences are worth restoring; the crash file is device-local debug
     output. The app no longer keeps an analysis cache: the "analysis" exclude
     stays for old installs that may still hold one. -->
<full-backup-content>
    <exclude
        domain="file"
        path="analysis" />
    <exclude
        domain="file"
        path="crash-latest.txt" />
    <!-- The replayed takes Record no longer makes (megabytes of JSON per
         performance). EditorProjectStore deletes project-takes/ at the first
         start of this version; until then a backup must not carry it, for the
         same quota as the rest of the app's files. Recordings go to the Videos library
         or a picked folder, and one in progress is a cacheDir scratch file,
         so neither is backed up here. -->
    <exclude
        domain="file"
        path="project-takes" />
</full-backup-content>
