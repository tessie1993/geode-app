<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. <cloud-backup> is the same shape as backup_rules.xml: keep
     user-authored data, drop the crash file and the old "analysis" folder (no
     longer written; the exclude stays for old installs that may still hold one).
     <device-transfer> is deliberately NOT - see its own comment below.
     BackupRulesCoverageTest pins both, and the difference between them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="analysis" />
        <exclude
            domain="file"
            path="crash-latest.txt" />
        <exclude
            domain="file"
            path="milk/generated" />
        <!-- User-imported texture images are large and re-importable; left
             in, they push the total past the cloud quota and backup of
             EVERYTHING (presets, playlists, history) silently stops. -->
        <exclude
            domain="file"
            path="milk/textures" />
        <!-- The replayed takes Record no longer makes (megabytes of JSON per
             performance). EditorProjectStore deletes project-takes/ at the first
             start of this version; until then a backup must not carry it, for the
             same quota as the textures above. Recordings go to the Videos library
             or a picked folder, and one in progress is a cacheDir scratch file,
             so neither is backed up here. -->
        <exclude
            domain="file"
            path="project-takes" />
    </cloud-backup>
    <!-- A direct phone-to-phone copy has no cloud quota, so the excludes above
         are not repeated here: the imported textures come across whole.
         Only the crash file is dropped, because it describes hardware the
         user just stopped using. -->
    <device-transfer>
        <exclude
            domain="file"
            path="crash-latest.txt" />
    </device-transfer>
</data-extraction-rules>
