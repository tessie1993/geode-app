<?xml version="1.0" encoding="utf-8"?>
<!-- The sideload build is release-like (minified, not debuggable): profileable lets Perfetto, simpleperf
     and Macrobenchmark attach to it from the shell, so its timings can be measured. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <profileable android:shell="true" />
    </application>
</manifest>
