#!/usr/bin/env bash
# g++ for the host tests in CI. A line that compiles and links several sources builds each
# source once per flag set, in parallel, and later lines reuse the objects. Same compiler,
# same flags per source; any other use (-c, no source) goes straight to the real g++.
set -euo pipefail

REAL="${HOSTCC_REAL:-/usr/bin/g++}"
CACHE="${HOSTCC_CACHE:-${RUNNER_TEMP:-/tmp}/hostcc}"

srcs=()
compile=()
skip=0
for a in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$a" in
    -c|-E|-S|-M*|-x|-shared|@*) exec "$REAL" "$@" ;;
    -o) skip=1 ;;
    *.cpp|*.cc|*.cxx) srcs+=("$a") ;;
    *.o|*.a|*.so|-l*|-L*|-Wl,*) ;;
    *) compile+=("$a") ;;
  esac
done
[ "${#srcs[@]}" -gt 0 ] || exec "$REAL" "$@"

mkdir -p "$CACHE"
flags_key=$({ "$REAL" --version; pwd; printf '%s\0' "${compile[@]}"; } | sha256sum | cut -c1-16)

declare -A obj
todo=()
for s in "${srcs[@]}"; do
  [ -n "${obj[$s]:-}" ] && continue
  o="$CACHE/$flags_key-$(sha256sum < "$s" | cut -c1-16)-$(printf '%s' "$s" | sha256sum | cut -c1-16).o"
  obj[$s]=$o
  [ -f "$o" ] || todo+=("$s" "$o")
done

if [ "${#todo[@]}" -gt 0 ]; then
  printf '%s\0' "${todo[@]}" | xargs -0 -n 2 -P "$(nproc)" bash -c '
    n=$#; src=${@:n-1:1}; out=${@:n:1}; set -- "${@:1:n-2}"
    "$@" -c "$src" -o "$out.$$.tmp" && mv "$out.$$.tmp" "$out"' _ "$REAL" "${compile[@]}" \
    || { echo "hostcc: a source of this line did not compile" >&2; exit 1; }
fi

link=()
for a in "$@"; do
  case "$a" in
    *.cpp|*.cc|*.cxx) link+=("${obj[$a]}") ;;
    *) link+=("$a") ;;
  esac
done
exec "$REAL" "${link[@]}"
