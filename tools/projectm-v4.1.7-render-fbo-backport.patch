+void PresetTransition::SetFrameTime(double seconds)
+{
+    if (m_userStartTime < 0.0)
+    {
+        m_userStartTime = seconds;
+        m_userLastFrameTime = seconds;
+    }
+    m_userFrameTime = seconds;
+}
+
+auto PresetTransition::SecondsSinceStart() const -> double
+{
+    if (m_userFrameTime >= 0.0)
+    {
+        return m_userFrameTime - m_userStartTime;
+    }
+    return std::chrono::duration<double>(std::chrono::system_clock::now() - m_transitionStartTime).count();
+}
