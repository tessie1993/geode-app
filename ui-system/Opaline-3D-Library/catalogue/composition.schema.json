{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opaline text-free 3D composition collection",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "category", "textFree", "parts", "contentFrames", "behaviorBindings", "implementation"],
    "properties": {
      "id": {"type": "string", "pattern": "^UI[0-9]{3}$"},
      "name": {"type": "string", "minLength": 1},
      "category": {"type": "string"},
      "textFree": {"const": true},
      "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
      "contentFrames": {"type": "array", "items": {"$ref": "#/$defs/contentFrame"}},
      "behaviorBindings": {"type": "array", "items": {"type": "object", "required": ["event", "action", "target", "parameters", "execution"]}},
      "implementation": {"type": "object", "required": ["geometry", "interaction", "semanticUI"]}
    }
  },
  "$defs": {
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "part": {
      "type": "object",
      "required": ["id", "element", "position", "rotation", "scale", "dimensions", "material"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "element": {"type": "string", "pattern": "^[A-Z][0-9]{2}$"},
        "position": {"$ref": "#/$defs/vec3"},
        "rotation": {"$ref": "#/$defs/vec3"},
        "scale": {"$ref": "#/$defs/vec3"},
        "dimensions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
        "material": {"enum": ["gel", "blue", "water", "shell", "pigment", "film", "nacre", "stone", "leaf", "glow"]}
      }
    },
    "contentFrame": {
      "type": "object",
      "required": ["id", "owner", "position", "size", "role", "renderedContent"],
      "properties": {
        "id": {"type": "string"},
        "owner": {"type": "string"},
        "position": {"$ref": "#/$defs/vec3"},
        "size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "renderedContent": {"type": "null"}
      }
    }
  }
}
